    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build": "node tools/cdata.js",
    "dev": "nodemon -e js,html,htm,css,png,jpg,gif,ico,js -w tools/ -w wled00/data/ -x node tools/cdata.js",
