  "dependencies": {
    "clean-css": "^4.2.3",
    "html-minifier-terser": "^5.1.1",
    "inliner": "^1.13.1",
    "nodemon": "^2.0.20",
    "zlib": "^1.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2"
  }
}
